{% macro badge(s) %}
{% set c = {'published':'bg-emerald-100 text-emerald-800','draft':'bg-stone-200 text-stone-700','review':'bg-amber-100 text-amber-800','archived':'bg-stone-300 text-stone-700',
  'new':'bg-sky-100 text-sky-800','contacted':'bg-amber-100 text-amber-800','quoted':'bg-violet-100 text-violet-800','confirmed':'bg-emerald-100 text-emerald-800','paid':'bg-emerald-200 text-emerald-900',
  'completed':'bg-stone-200 text-stone-800','cancelled':'bg-red-100 text-red-800','in-progress':'bg-amber-100 text-amber-800','replied':'bg-emerald-100 text-emerald-800','closed':'bg-stone-200 text-stone-700'} %}
<span class="rounded-full px-2.5 py-0.5 text-xs font-semibold {{ c[s] or 'bg-stone-100 text-stone-700' }}">{{ s }}</span>
{% endmacro %}

{% macro pager(page, pages, base) %}
{% if pages > 1 %}<nav class="mt-4 flex items-center justify-between text-sm" aria-label="Pagination">
  <span class="text-stone-500">Page {{ page }} of {{ pages }}</span>
  <span class="flex gap-2">{% if page > 1 %}<a class="btn btn-outline" href="{{ base }}{{ '&' if '?' in base else '?' }}page={{ page - 1 }}">Previous</a>{% endif %}
  {% if page < pages %}<a class="btn btn-outline" href="{{ base }}{{ '&' if '?' in base else '?' }}page={{ page + 1 }}">Next</a>{% endif %}</span></nav>{% endif %}
{% endmacro %}

{% macro csrf(token) %}<input type="hidden" name="_csrf" value="{{ token }}">{% endmacro %}

{% macro input(f, values, errors, options) %}
<div class="{{ 'sm:col-span-2' if f.type in ['textarea','lines','multi'] }}">
  <label class="label" for="f-{{ f.name }}">{{ f.label }}{% if f.required %} *{% endif %}</label>
  {% if f.type == 'textarea' or f.type == 'lines' %}
    <textarea id="f-{{ f.name }}" name="{{ f.name }}" rows="{{ f.rows or 4 }}" class="field">{{ values[f.name] }}</textarea>
  {% elif f.type == 'select' %}
    <select id="f-{{ f.name }}" name="{{ f.name }}" class="field">
      {% if f.nullable %}<option value="">None</option>{% endif %}
      {% if f.options %}{% for o in f.options %}<option value="{{ o }}" {{ 'selected' if values[f.name] == o }}>{{ o | titleCase }}</option>{% endfor %}
      {% else %}{% for o in options[f.name] %}<option value="{{ o.value }}" {{ 'selected' if values[f.name] == o.value }}>{{ o.label }}</option>{% endfor %}{% endif %}
    </select>
  {% elif f.type == 'multi' %}
    <div class="grid gap-1 rounded-md border border-stone-300 bg-white p-3 sm:grid-cols-2 lg:grid-cols-3">
      {% for o in options[f.name] %}<label class="flex items-center gap-2 text-sm"><input type="checkbox" name="{{ f.name }}" value="{{ o.value }}" {{ 'checked' if o.value in values[f.name] }}> {{ o.label }}</label>{% endfor %}
    </div>
  {% elif f.type == 'checkbox' %}
    <label class="flex items-center gap-2 text-sm"><input id="f-{{ f.name }}" type="checkbox" name="{{ f.name }}" {{ 'checked' if values[f.name] }}> Yes</label>
  {% else %}
    <input id="f-{{ f.name }}" name="{{ f.name }}" type="{{ 'number' if f.type in ['number','decimal'] else ('date' if f.type == 'date' else 'text') }}" {% if f.type == 'decimal' %}step="0.1" min="1" max="5"{% endif %} value="{{ values[f.name] if values[f.name] is not none }}" class="field">
  {% endif %}
  {% if f.hint %}<p class="mt-1 text-xs text-stone-500">{{ f.hint }}</p>{% endif %}
  {% if errors[f.name] %}<p class="error">{{ errors[f.name] }}</p>{% endif %}
</div>
{% endmacro %}
