{% extends "layouts/admin.njk" %}
{% from "admin/_macros.njk" import pager %}
{% block title %}Audit log{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">Audit log</h1>
<form method="get" class="mt-4 flex gap-2"><label class="sr-only" for="entity">Entity</label><select id="entity" name="entity" class="field max-w-48"><option value="">All records</option>{% for e in entities %}<option value="{{ e }}" {{ 'selected' if entity == e }}>{{ e }}</option>{% endfor %}</select><button class="btn btn-dark">Filter</button></form>
<div class="mt-4 overflow-x-auto rounded-xl bg-white shadow-sm ring-1 ring-black/5"><table class="w-full text-left text-sm">
  <thead class="bg-stone-50 text-xs uppercase tracking-wide text-stone-500"><tr><th class="px-4 py-3">When</th><th class="px-4 py-3">Who</th><th class="px-4 py-3">Action</th><th class="px-4 py-3">Record</th><th class="px-4 py-3">IP</th></tr></thead>
  <tbody class="divide-y">{% for a in rows %}<tr><td class="px-4 py-2 whitespace-nowrap">{{ a.created_at | date }}</td><td class="px-4 py-2">{{ a.full_name or 'System' }}</td><td class="px-4 py-2">{{ a.action }}</td><td class="px-4 py-2">{{ a.entity }}</td><td class="px-4 py-2 text-stone-500">{{ a.ip }}</td></tr>
  {% else %}<tr><td colspan="5" class="px-4 py-8 text-center text-stone-500">No activity yet.</td></tr>{% endfor %}</tbody></table></div>
{{ pager(page, pages, '/admin/audit-log?entity=' + (entity | urlencode)) }}
{% endblock %}
