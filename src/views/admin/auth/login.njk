<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Plus Discovery Adventure</title>
  <link rel="icon" href="/img/logo.png">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="grid min-h-screen place-items-center bg-ink px-4">
  <main class="w-full max-w-sm">
    <div class="rounded-xl bg-white p-8 shadow-xl">
      <img src="/img/logo.png" alt="Plus Discovery" class="mx-auto h-16 w-auto">
      <h1 class="mt-4 text-center text-2xl font-bold">Staff sign in</h1>
      {% if error %}<p role="alert" class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-800">{{ error }}</p>{% endif %}
      <form method="post" action="/admin/login" class="mt-6 space-y-4">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div><label class="label" for="email">Email</label><input id="email" name="email" type="email" value="{{ email }}" required autocomplete="username" class="field"></div>
        <div><label class="label" for="password">Password</label><input id="password" name="password" type="password" required autocomplete="current-password" class="field"></div>
        <button class="btn btn-dark w-full">Sign in</button>
      </form>
    </div>
  </main>
</body>
</html>
