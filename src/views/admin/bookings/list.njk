{% extends "layouts/admin.njk" %}
{% from "admin/_macros.njk" import badge, pager %}
{% block title %}Bookings{% endblock %}
{% block content %}
<div class="flex flex-wrap items-center justify-between gap-3"><h1 class="text-2xl font-bold">Bookings</h1>
  <a class="btn btn-outline" href="/admin/bookings/export.csv">Export CSV</a></div>
<form method="get" class="mt-4 flex flex-wrap gap-2">
  <label class="sr-only" for="q">Search</label><input id="q" name="q" value="{{ q }}" placeholder="Name, email or reference" class="field max-w-xs">
  <label class="sr-only" for="status">Status</label><select id="status" name="status" class="field max-w-44"><option value="">All statuses</option>{% for s in statuses %}<option value="{{ s }}" {{ 'selected' if status == s }}>{{ s | titleCase }}</option>{% endfor %}</select>
  <button class="btn btn-dark">Filter</button>
</form>
<div class="mt-4 overflow-x-auto rounded-xl bg-white shadow-sm ring-1 ring-black/5"><table class="w-full text-left text-sm">
  <thead class="bg-stone-50 text-xs uppercase tracking-wide text-stone-500"><tr><th class="px-4 py-3">Reference</th><th class="px-4 py-3">Customer</th><th class="px-4 py-3">Trip</th><th class="px-4 py-3">Travel date</th><th class="px-4 py-3">Travellers</th><th class="px-4 py-3">Total</th><th class="px-4 py-3">Status</th></tr></thead>
  <tbody class="divide-y">{% for b in rows %}<tr class="hover:bg-stone-50">
    <td class="px-4 py-3"><a class="font-medium text-sand-dark hover:underline" href="/admin/bookings/{{ b.id }}">{{ b.reference }}</a></td>
    <td class="px-4 py-3">{{ b.customer_name }}<br><span class="text-xs text-stone-500">{{ b.customer_email }}</span></td>
    <td class="px-4 py-3">{{ b.tour or '—' }}</td><td class="px-4 py-3">{{ b.travel_date | date if b.travel_date else '—' }}</td>
    <td class="px-4 py-3">{{ b.adults }}{{ ' + ' + b.children + ' child' if b.children }}</td><td class="px-4 py-3">{{ b.total_amount | money }}</td><td class="px-4 py-3">{{ badge(b.status) }}</td></tr>
  {% else %}<tr><td colspan="7" class="px-4 py-8 text-center text-stone-500">No bookings yet. Requests from the website appear here.</td></tr>{% endfor %}</tbody></table></div>
{{ pager(page, pages, '/admin/bookings?q=' + (q | urlencode) + '&status=' + status) }}
{% endblock %}
