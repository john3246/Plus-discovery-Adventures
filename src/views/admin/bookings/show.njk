{% extends "layouts/admin.njk" %}
{% from "admin/_macros.njk" import badge %}
{% block title %}Booking {{ b.reference }}{% endblock %}
{% block content %}
<nav class="text-sm text-stone-500"><a href="/admin/bookings" class="hover:underline">Bookings</a> / {{ b.reference }}</nav>
<h1 class="mt-1 text-2xl font-bold">{{ b.reference }} {{ badge(b.status) }}</h1>
<div class="mt-5 grid gap-6 lg:grid-cols-3">
  <section class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-black/5 lg:col-span-2">
    <dl class="grid gap-4 text-sm sm:grid-cols-2">
      <div><dt class="label">Customer</dt><dd>{{ b.customer_name }}</dd></div>
      <div><dt class="label">Email</dt><dd><a class="text-sand-dark" href="mailto:{{ b.customer_email }}">{{ b.customer_email }}</a></dd></div>
      <div><dt class="label">Phone</dt><dd>{{ b.customer_phone or '—' }}</dd></div><div><dt class="label">Country</dt><dd>{{ b.country or '—' }}</dd></div>
      <div><dt class="label">Trip</dt><dd>{% if b.tour_slug %}<a class="text-sand-dark" target="_blank" rel="noopener" href="/en/tours/{{ b.tour_slug }}">{{ b.tour }}</a>{% else %}—{% endif %}</dd></div>
      <div><dt class="label">Travel date</dt><dd>{{ b.travel_date | date if b.travel_date else '—' }}</dd></div>
      <div><dt class="label">Travellers</dt><dd>{{ b.adults }} adults, {{ b.children }} children</dd></div><div><dt class="label">Received</dt><dd>{{ b.created_at | date }}</dd></div>
      <div class="sm:col-span-2"><dt class="label">Message</dt><dd class="whitespace-pre-line">{{ b.message or '—' }}</dd></div>
    </dl>
    <h2 class="mt-8 font-sans text-sm font-semibold uppercase tracking-wider text-stone-500">Timeline</h2>
    <ol class="mt-3 space-y-2 border-l-2 border-stone-200 pl-4 text-sm">{% for e in events %}<li><b>{{ e.type }}</b> {{ e.note }}<br><span class="text-xs text-stone-500">{{ e.created_at | date }}{{ ' · ' + e.full_name if e.full_name }}</span></li>{% endfor %}</ol>
  </section>
  <form method="post" action="/admin/bookings/{{ b.id }}" class="space-y-4 rounded-xl bg-white p-6 shadow-sm ring-1 ring-black/5">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div><label class="label" for="status">Status</label><select id="status" name="status" class="field">{% for s in statuses %}<option value="{{ s }}" {{ 'selected' if b.status == s }}>{{ s | titleCase }}</option>{% endfor %}</select></div>
    <div><label class="label" for="total">Total (USD)</label><input id="total" name="total_amount" type="number" min="0" value="{{ b.total_amount }}" class="field"></div>
    <div><label class="label" for="notes">Internal notes</label><textarea id="notes" name="internal_notes" rows="6" class="field">{{ b.internal_notes }}</textarea></div>
    {% if can('bookings:update') %}<button class="btn btn-primary w-full">Save changes</button>{% endif %}
  </form>
</div>
{% endblock %}
