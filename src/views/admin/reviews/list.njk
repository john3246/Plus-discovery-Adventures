{% extends "layouts/admin.njk" %}
{% from "admin/_macros.njk" import badge %}
{% block title %}Reviews{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">Reviews</h1>
<div class="mt-4 space-y-3">{% for r in rows %}
  <article class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-black/5">
    <div class="flex flex-wrap items-center justify-between gap-2"><p class="font-semibold">{{ r.author_name }}, {{ r.country }} <span class="text-sand">{{ '★★★★★'.slice(0, r.rating) }}</span></p>
      <span>{{ badge('published' if r.is_approved else 'draft') }}</span></div>
    <p class="mt-2 text-sm text-stone-700">{{ r.body }}</p>
    <p class="mt-1 text-xs text-stone-500">{{ r.tour or 'General' }} · {{ r.source }} · {{ r.created_at | date }}</p>
    {% if can('reviews:update') %}<div class="mt-3 flex gap-2">
      {% if not r.is_approved %}<form method="post" action="/admin/reviews/{{ r.id }}/approve"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn-primary">Approve</button></form>{% endif %}
      {% if r.is_approved %}<form method="post" action="/admin/reviews/{{ r.id }}/hide"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn-outline">Hide</button></form>{% endif %}</div>{% endif %}
  </article>{% else %}<p class="rounded-xl bg-white p-8 text-center text-stone-500">No reviews yet.</p>{% endfor %}</div>
{% endblock %}
