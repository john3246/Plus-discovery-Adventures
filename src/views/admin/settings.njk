{% extends "layouts/admin.njk" %}
{% block title %}Settings{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">Site settings</h1>
<form method="post" action="/admin/settings" class="mt-5 grid max-w-2xl gap-4 rounded-xl bg-white p-6 shadow-sm ring-1 ring-black/5 sm:grid-cols-2">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  {% for f in fields %}<div><label class="label" for="s-{{ f[0] }}">{{ f[1] }}</label><input id="s-{{ f[0] }}" name="{{ f[0] }}" value="{{ values[f[0]] }}" class="field"></div>{% endfor %}
  {% if can('settings:update') %}<div class="sm:col-span-2"><button class="btn btn-primary">Save settings</button></div>{% endif %}
</form>
{% endblock %}
