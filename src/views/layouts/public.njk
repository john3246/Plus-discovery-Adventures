<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site.fullName }} | Tanzania Safaris, Kilimanjaro & Zanzibar{% endblock %}</title>
  <meta name="description" content="{% block description %}Tailor-made Tanzania safaris, Kilimanjaro climbs, day trips and Zanzibar beach holidays.{% endblock %}">
  <link rel="canonical" href="{{ site.url or '' }}/{{ lang }}{{ path if path != '/' else '' }}">
  <link rel="icon" href="/img/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">{% block content %}{% endblock %}</main>
  {% include "partials/footer.njk" %}
  <script type="module" src="/js/main.js"></script>
</body>
</html>
