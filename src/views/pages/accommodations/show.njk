{% extends "layouts/public.njk" %}
{% from "partials/macros.njk" import pageHero %}
{% block title %}{{ stay.name }} | {{ site.fullName }}{% endblock %}
{% block content %}
{{ pageHero(stay.name, stay.type ~ (' in ' ~ destination.name if destination else ''), stay.name) }}
<div class="container-x grid gap-10 py-14 lg:grid-cols-[1.3fr_1fr]">
  <img src="{{ stay.image | unsplash(1000, 700) }}" alt="{{ stay.name }}" class="w-full rounded-xl object-cover">
  <div><p class="text-stone-700">{{ stay.description }}</p>
    <h2 class="mt-6 text-2xl font-bold">Amenities</h2><ul class="mt-3 list-disc space-y-1 pl-5">{% for a in stay.amenities %}<li>{{ a }}</li>{% endfor %}</ul>
    <a class="btn btn-primary mt-8" href="/{{ lang }}/contact">Enquire about this stay</a></div>
</div>
{% endblock %}
