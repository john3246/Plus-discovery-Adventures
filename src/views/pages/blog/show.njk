{% extends "layouts/public.njk" %}
{% block title %}{{ post.title }} | {{ site.fullName }}{% endblock %}
{% block description %}{{ post.excerpt }}{% endblock %}
{% block ogImage %}{{ post.image | unsplash(1200, 630) }}{% endblock %}
{% block ogType %}article{% endblock %}
{% block content %}
<article class="container-x max-w-3xl py-14">
  <p class="eyebrow">{{ post.category }} · {{ post.date | date }}</p><h1 class="mt-2 text-4xl font-bold">{{ post.title }}</h1>
  <img src="{{ post.image | unsplash(1200, 700) }}" alt="{{ post.title }}" class="mt-6 w-full rounded-xl object-cover">
  <div class="mt-8 space-y-5 text-lg leading-relaxed text-stone-700">{% for para in post.body %}<p>{{ link(para) }}</p>{% endfor %}</div>
  <aside class="card mt-10 p-6"><h2 class="text-xl font-bold">Park guides</h2><ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">{% for g in parkGuides %}<li><a class="inline-link" href="/{{ lang }}/destinations/{{ g.slug }}">{{ g.name }}</a></li>{% endfor %}</ul></aside>
  <div class="mt-10"><a class="btn btn-primary" href="/{{ lang }}/plan-your-trip">Plan your trip</a></div>
</article>
<section class="section bg-white"><div class="container-x"><h2 class="mb-6 text-2xl font-bold">More to read</h2><div class="grid gap-6 md:grid-cols-3">{% for p in related %}<a href="/{{ lang }}/blog/{{ p.slug }}" class="card block p-5"><h3 class="font-semibold">{{ p.title }}</h3><p class="mt-1 text-sm text-stone-600">{{ p.excerpt }}</p></a>{% endfor %}</div></div></section>
{% endblock %}
