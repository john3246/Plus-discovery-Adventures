{% extends "layouts/public.njk" %}
{% from "partials/macros.njk" import pageHero, field %}
{% block title %}Contact Us | {{ site.fullName }}{% endblock %}
{% block content %}
{{ pageHero('Contact us', 'Questions? We reply within one working day.', 'Contact') }}
<section class="section"><div class="container-x grid gap-10 lg:grid-cols-[1fr_340px]">
  <div class="card p-6 sm:p-8">
    {% if sent %}<p class="mb-6 rounded bg-green-50 p-4 text-green-800">Thank you. Your message has been received.</p>{% endif %}
    <form method="post" action="/{{ lang }}/contact" class="grid gap-4 sm:grid-cols-2" novalidate>
      {{ field('name', 'Your name', values, errors, 'text', true) }}
      {{ field('email', 'Email', values, errors, 'email', true) }}
      {{ field('phone', 'Phone', values, errors, 'tel') }}
      {{ field('country', 'Country', values, errors) }}
      <div class="sm:col-span-2"><label class="label" for="f-message">Message *</label><textarea class="field" id="f-message" name="message" rows="5" required>{{ values.message }}</textarea>{% if errors.message %}<p class="error">{{ errors.message }}</p>{% endif %}</div>
      <div class="hidden" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <div class="sm:col-span-2"><button class="btn btn-primary">Send message</button></div>
    </form>
  </div>
  <aside class="space-y-3 text-sm"><h2 class="font-serif text-xl font-bold">Visit or call</h2><p>{{ site.address }}</p><p><a class="text-sand-dark" href="tel:{{ site.phone }}">{{ site.phone }}</a></p><p><a class="text-sand-dark" href="mailto:{{ site.email }}">{{ site.email }}</a></p></aside>
</div></section>
{% endblock %}
