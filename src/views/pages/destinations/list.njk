{% extends "layouts/public.njk" %}
{% from "partials/macros.njk" import destCard %}
{% from "partials/heroSlides.njk" import heroSlides %}
{% block title %}Tanzania Destinations | {{ site.fullName }}{% endblock %}
{% block description %}Explore Tanzania destinations: Serengeti, Ngorongoro, Tarangire, Lake Manyara, Arusha, Kilimanjaro and Zanzibar.{% endblock %}
{% block content %}
{% call heroSlides(slides, words, 'Explore') %}
  <nav class="text-xs text-stone-300"><a href="/{{ lang }}">Home</a> / Destinations</nav>
  <h1 class="mt-3 text-4xl font-bold sm:text-6xl" data-scramble>Destinations</h1>
  <p class="mt-3 text-xl text-stone-200">National parks, mountains and islands.</p>
{% endcall %}
<section class="section"><div class="container-x grid grid-cols-2 gap-4 lg:grid-cols-4">{% for d in items %}{{ destCard(d, lang) }}{% endfor %}</div></section>
{% endblock %}
