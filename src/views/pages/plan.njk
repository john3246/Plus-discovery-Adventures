{% extends "layouts/public.njk" %}
{% from "partials/macros.njk" import pageHero, field %}
{% block title %}Plan Your Trip | {{ site.fullName }}{% endblock %}
{% block content %}
{{ pageHero('Plan your trip', 'Tell us what you have in mind. We reply with a tailored proposal.', 'Plan your trip') }}
<section class="section"><div class="container-x max-w-3xl"><div class="card p-6 sm:p-8">
  {% if sent %}<p class="mb-6 rounded bg-green-50 p-4 text-green-800">Thank you. A travel planner will contact you shortly.</p>{% endif %}
  <form method="post" action="/{{ lang }}/plan-your-trip" class="grid gap-4 sm:grid-cols-2" novalidate>
    <div><label class="label" for="f-interest">Adventure type</label><select class="field" id="f-interest" name="interest">{% for o in ['safari','kilimanjaro','day-trip','zanzibar','honeymoon'] %}<option value="{{ o }}" {{ 'selected' if values.interest == o }}>{{ o | titleCase }}</option>{% endfor %}</select></div>
    <div><label class="label" for="f-duration">Duration</label><select class="field" id="f-duration" name="duration"><option value="">Not sure</option><option>1-3 days</option><option>4-6 days</option><option>7-10 days</option><option>10+ days</option></select></div>
    {{ field('arrival', 'Estimated arrival date', values, errors, 'date') }}
    {{ field('adults', 'Adults', values, errors, 'number', true) }}
    {{ field('children', 'Children', values, errors, 'number') }}
    {{ field('country', 'Country', values, errors) }}
    {{ field('name', 'Your name', values, errors, 'text', true) }}
    {{ field('email', 'Email', values, errors, 'email', true) }}
    {{ field('phone', 'Phone', values, errors, 'tel') }}
    <div class="sm:col-span-2"><label class="label" for="f-message">Notes</label><textarea class="field" id="f-message" name="message" rows="4">{{ values.message }}</textarea></div>
    <div class="hidden" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
    <div class="sm:col-span-2"><button class="btn btn-primary">Request my proposal</button></div>
  </form></div></div></section>
{% endblock %}
