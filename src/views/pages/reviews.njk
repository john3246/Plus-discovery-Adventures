{% extends "layouts/public.njk" %}
{% from "partials/macros.njk" import pageHero, stars %}
{% block title %}Traveller Reviews | {{ site.fullName }}{% endblock %}
{% block description %}Traveller reviews of Plus Discovery Adventure trips in Tanzania.{% endblock %}
{% block content %}
{{ pageHero('Traveller reviews', 'What our guests say.') }}
<section class="section"><div class="container-x grid gap-6 md:grid-cols-3">{% for r in reviews %}<figure class="card p-6"><div>{{ stars(r.rating) }}</div><blockquote class="mt-3 text-stone-700">{{ r.text }}</blockquote><figcaption class="mt-4 text-sm font-semibold">{{ r.author }}, {{ r.country }}</figcaption></figure>{% endfor %}</div>
  {% if isDev %}<p class="container-x mt-6 text-xs text-stone-500">Sample reviews: replace with real, approved reviews before launch.</p>{% endif %}</section>
{% endblock %}
