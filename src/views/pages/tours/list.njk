{% extends "layouts/public.njk" %}
{% from "partials/macros.njk" import tourCard, fillCard %}
{% block title %}{{ title }} | {{ site.fullName }}{% endblock %}
{% block description %}{{ intro }} Compare itineraries and prices with {{ site.fullName }}.{% endblock %}

{% block content %}
<section class="bg-ink py-8 text-white"><div class="container-x"><nav class="text-xs text-stone-300"><a href="/{{ lang }}">Home</a> / {{ title }}</nav>
  <h1 class="mt-2 text-4xl font-bold">{{ title }}</h1><p class="mt-2 max-w-2xl text-stone-300">{{ intro }}</p></div></section>

<nav class="border-b border-black/5 bg-white" aria-label="Park guides"><div class="container-x flex gap-2 overflow-x-auto py-3 text-sm"><span class="whitespace-nowrap py-1 font-semibold">Park guides:</span>{% for g in parkGuides %}<a class="whitespace-nowrap rounded-full border border-black/10 px-3 py-1 hover:border-sand hover:text-sand-dark" href="/{{ lang }}/destinations/{{ g.slug }}">{{ g.name }}</a>{% endfor %}</div></nav>

<section class="section">
  <div class="container-x grid gap-8 lg:grid-cols-[260px_1fr]">
    <form method="get" action="{{ basePath }}" class="group card h-fit space-y-4 p-5 lg:sticky lg:top-[96px] lg:max-h-[calc(100vh-112px)] lg:overflow-y-auto" aria-label="Filter trips">
      <h2 class="font-sans text-sm font-bold uppercase tracking-wider">Filter trips</h2>
      <label class="btn btn-outline w-full cursor-pointer lg:hidden"><input type="checkbox" class="filter-toggle sr-only">Show or hide filters</label>
      <div class="hidden space-y-4 group-has-[.filter-toggle:checked]:block lg:block">
      <fieldset><legend class="label">Category</legend>
        {% for c in categories %}<label class="flex items-center gap-2 py-1 text-sm"><input type="radio" name="category" value="{{ c.key }}" {{ 'checked' if category == c.key }}><span class="flex-1">{{ c.label }}</span><span class="text-xs text-stone-500">{{ c.count }}</span></label>{% endfor %}</fieldset>
      <fieldset><legend class="label">Safari style</legend>
        <label class="flex items-center gap-2 py-1 text-sm"><input type="radio" name="style" value="" {{ 'checked' if not query.style }}><span class="flex-1">Any style</span><span class="text-xs text-stone-500">{{ total }}</span></label>
        {% for s in styles %}<label class="flex items-center gap-2 py-1 text-sm"><input type="radio" name="style" value="{{ s.key }}" {{ 'checked' if query.style == s.key }}><span class="flex-1">{{ s.label }}</span><span class="text-xs text-stone-500">{{ s.count }}</span></label>{% endfor %}</fieldset>
      <div><label class="label" for="s-dur">Duration</label>
        <select id="s-dur" name="duration" class="field"><option value="">Any</option>
          <option value="short" {{ 'selected' if query.duration == 'short' }}>1 to 3 days</option>
          <option value="medium" {{ 'selected' if query.duration == 'medium' }}>4 to 6 days</option>
          <option value="long" {{ 'selected' if query.duration == 'long' }}>7+ days</option></select></div>
      <div><label class="label" for="s-price">Max price (pp)</label>
        <select id="s-price" name="maxPrice" class="field"><option value="">Any</option>
          {% for p in [500, 1500, 3000, 5000] %}<option value="{{ p }}" {{ 'selected' if query.maxPrice == p }}>Up to {{ p | money }}</option>{% endfor %}</select></div>
      <div><label class="label" for="s-sort">Sort by</label>
        <select id="s-sort" name="sort" class="field"><option value="popular">Popularity</option>
          <option value="price" {{ 'selected' if query.sort == 'price' }}>Price</option>
          <option value="duration" {{ 'selected' if query.sort == 'duration' }}>Duration</option></select></div>
      <div class="sticky -bottom-5 -mx-5 space-y-2 border-t bg-white px-5 py-3">
      <button class="btn btn-dark w-full">Apply filters</button>
      <a href="{{ basePath }}" class="block text-center text-xs text-stone-500 hover:underline">Reset</a></div>
      </div>
    </form>
    <div>
      <p class="mb-4 text-sm text-stone-600">{{ items | length }} trip{{ '' if items | length == 1 else 's' }}</p>
      {% if items | length %}
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">{% for t in items %}{{ tourCard(t, lang) }}{% endfor %}{% if items | length < 3 %}{{ fillCard(lang, 'Looking for something else?', 'xl:col-span-2' if items | length == 1 else '') }}{% endif %}</div>
      {% else %}<p class="card p-8 text-center">No trips match these filters. <a class="text-sand-dark underline" href="{{ basePath }}">Reset</a> or <a class="text-sand-dark underline" href="/{{ lang }}/plan-your-trip">ask us to tailor one</a>.</p>{% endif %}
    </div>
  </div>
</section>
{% endblock %}
