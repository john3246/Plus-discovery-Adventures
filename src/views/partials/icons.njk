{# Orange line icons (stroke only). Usage: {{ icon('price') }} #}
{% macro icon(name, cls='h-14 w-14') %}
<svg class="{{ cls }} text-sand" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == 'price' %}<path d="M8 8h16l16 16-14 14L10 22z"/><circle cx="16" cy="16" r="2"/><path d="M26 20v10M30 22h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4h-6"/>
{% elif name == 'expert' %}<circle cx="24" cy="14" r="6"/><path d="M10 40c0-8 6-14 14-14s14 6 14 14"/><path d="M6 30l8 4M42 30l-8 4"/>
{% elif name == 'local' %}<circle cx="24" cy="12" r="6"/><path d="M14 10h20"/><path d="M12 40V26a12 12 0 0 1 24 0v14"/><path d="M12 30h24"/><path d="M8 40V22l8 3"/>
{% elif name == 'custom' %}<circle cx="24" cy="24" r="16"/><path d="M15 26l5 5 13-14"/>
{% elif name == 'safety' %}<path d="M24 5l16 6v12c0 10-7 17-16 20C15 40 8 33 8 23V11z"/><path d="M17 24l5 5 9-10"/>
{% elif name == 'heart' %}<path d="M24 41S7 31 7 19a9 9 0 0 1 17-4 9 9 0 0 1 17 4c0 12-17 22-17 22z"/>
{% elif name == 'map' %}<path d="M24 43S10 30 10 20a14 14 0 0 1 28 0c0 10-14 23-14 23z"/><circle cx="24" cy="20" r="5"/>
{% elif name == 'compass' %}<circle cx="24" cy="24" r="17"/><path d="M31 17l-5 10-10 5 5-10z"/>
{% elif name == 'calendar' %}<rect x="7" y="10" width="34" height="30" rx="3"/><path d="M7 19h34M16 6v8M32 6v8"/>
{% elif name == 'chat' %}<path d="M8 10h32v22H22l-9 8v-8H8z"/><path d="M16 19h16M16 25h10"/>
{% elif name == 'plane' %}<path d="M6 28l36-12-8 20-8-6-6 6-2-8z"/>
{% endif %}
</svg>
{% endmacro %}
